<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everyone: own requisitions only -->
    <record id="rule_material_requisition_own" model="ir.rule">
        <field name="name">Material Requisition: own records</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">['|', ('employee_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Department approvers: own + their department's -->
    <record id="rule_material_requisition_dept_manager" model="ir.rule">
        <field name="name">Material Requisition: department manager</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">['|', '|', ('employee_user_id', '=', user.id), ('create_uid', '=', user.id), ('department_manager_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_material_requisition_manager'))]"/>
    </record>

    <!-- Final approvers: everything -->
    <record id="rule_material_requisition_all" model="ir.rule">
        <field name="name">Material Requisition: all records</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_material_requisition_user'))]"/>
    </record>
</odoo>