#. module: inom_material_purchase_requisition
#: model:mail.template,body_html:inom_material_purchase_requisition.mail_template_manager_approval
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    A new material requisition\n"
"                    <strong t-out=\"object.name or ''\">MR/0001</strong>\n"
"                    submitted by\n"
"                    <t t-out=\"object.employee_id.name or ''\">Employee</t>\n"
"                    is waiting for your department approval.\n"
"                </p>\n"
"                <p>\n"
"                    Department:\n"
"                    <t t-out=\"object.department_id.name or ''\">Department</t><br>\n"
"                    Requisition Date:\n"
"                    <t t-out=\"object.request_date or ''\">Date</t>\n"
"                </p>\n"
"                <p>Please review and approve it in the system.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>مرحباً،</p>\n"
"                <p>\n"
"                    يوجد طلب مواد جديد\n"
"                    <strong t-out=\"object.name or ''\">MR/0001</strong>\n"
"                    مقدم من\n"
"                    <t t-out=\"object.employee_id.name or ''\">الموظف</t>\n"
"                    وينتظر موافقة القسم.\n"
"                </p>\n"
"                <p>\n"
"                    القسم:\n"
"                    <t t-out=\"object.department_id.name or ''\">القسم</t><br>\n"
"                    تاريخ الطلب:\n"
"                    <t t-out=\"object.request_date or ''\">التاريخ</t>\n"
"                </p>\n"
"                <p>يرجى المراجعة والموافقة من خلال النظام.</p>\n"
"            </div>\n"
"        "

#. module: inom_material_purchase_requisition
#: model:mail.template,body_html:inom_material_purchase_requisition.mail_template_user_approval
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    Material requisition\n"
"                    <strong t-out=\"object.name or ''\">MR/0001</strong>\n"
"                    has been approved by the department manager and is now\n"
"                    waiting for your final approval.\n"
"                </p>\n"
"                <p>\n"
"                    Employee:\n"
"                    <t t-out=\"object.employee_id.name or ''\">Employee</t><br>\n"
"                    Department:\n"
"                    <t t-out=\"object.department_id.name or ''\">Department</t>\n"
"                </p>\n"
"                <p>Please review and approve it in the system.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                <p>مرحباً،</p>\n"
"                <p>\n"
"                    تم اعتماد طلب المواد\n"
"                    <strong t-out=\"object.name or ''\">MR/0001</strong>\n"
"                    من قبل مدير القسم، وهو الآن\n"
"                    ينتظر موافقتك النهائية.\n"
"                </p>\n"
"                <p>\n"
"                    الموظف:\n"
"                    <t t-out=\"object.employee_id.name or ''\">الموظف</t><br>\n"
"                    القسم:\n"
"                    <t t-out=\"object.department_id.name or ''\">القسم</t>\n"
"                </p>\n"
"                <p>يرجى المراجعة والموافقة من خلال النظام.</p>\n"
"            </div>\n"
"        "

